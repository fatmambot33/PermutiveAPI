{
  "version": 1,
  "routes": [
    {
      "method": "GET",
      "path": "/v1/workspaces/current",
      "responses": [
        {
          "status_code": 200,
          "body": {
            "id": "workspace-fixture",
            "name": "Fixture Workspace"
          },
          "headers": {}
        }
      ]
    },
    {
      "method": "GET",
      "path": "/v1/cohorts",
      "responses": [
        {
          "status_code": 200,
          "body": {
            "items": [
              {"id": "cohort-alpha", "name": "Alpha"},
              {"id": "cohort-beta", "name": "Beta"}
            ]
          },
          "headers": {}
        }
      ]
    },
    {
      "method": "GET",
      "path": "/v1/segments/left",
      "responses": [
        {
          "status_code": 200,
          "body": {"id": "segment-left", "size": 120},
          "headers": {}
        }
      ]
    },
    {
      "method": "GET",
      "path": "/v1/segments/right",
      "responses": [
        {
          "status_code": 200,
          "body": {"id": "segment-right", "size": 80},
          "headers": {}
        }
      ]
    },
    {
      "method": "POST",
      "path": "/v1/cohorts/reviewed",
      "responses": [
        {
          "status_code": 201,
          "body": {
            "id": "cohort-reviewed",
            "state": "reviewed"
          },
          "headers": {}
        }
      ]
    },
    {
      "method": "GET",
      "path": "/v1/server-failure",
      "responses": [
        {
          "status_code": 500,
          "body": {"error": "server_failure"},
          "headers": {}
        }
      ]
    }
  ]
}
